# Copia este archivo a .env.local y llena los valores. .env.local NO se sube a git.
# Las llaves las captura Wal; nunca se imprimen ni se pegan en el chat.

# --- IA (docs/adr/0003) ---
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Opcionales: cambiar modelo u orden sin tocar código
# IA_MODELO_ANTHROPIC=claude-opus-5-5
# IA_ESFUERZO_ANTHROPIC=low
# IA_MODELO_GROQ=openai/gpt-oss-120b
# IA_ESFUERZO_GROQ=medium   # low | medium | high: más esfuerzo = sigue mejor las reglas, tarda más
# IA_ORDEN=anthropic,groq

# --- Voz del asistente (docs/adr/0016) ---
# ElevenLabs (voz principal). Los voice_id salen de la biblioteca de voces de ElevenLabs (alfanuméricos, ~20).
ELEVENLABS_API_KEY=
ELEVENLABS_VOZ=
ELEVENLABS_VOZ_CLIENTE=
ELEVENLABS_VOZ_CLIENTA=
# ELEVENLABS_MODELO=eleven_flash_v2_5   # el rápido y barato; alternativa: eleven_multilingual_v2
# Azure Speech (segunda opción, plan F0). Sin ninguna llave, el navegador dice el resumen con una voz femenina.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# AZURE_VOZ=es-MX-DaliaNeural            # la asistente; otra voz neural de es-MX sin tocar código
# AZURE_VOZ_CLIENTE=es-MX-JorgeNeural     # el cliente simulado de la práctica
# AZURE_VOZ_CLIENTA=es-MX-BeatrizNeural   # la clienta simulada

# --- Supabase (docs/adr/0009) ---
# Local: valores que imprime `supabase start`. Nube: Settings → API Keys del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta. Desde el ADR 0014 también la usa el SERVIDOR (acceso por número de reloj y alta de empleados): va en
# Vercel como sensitive. Nunca como NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Cuenta de admin de las demos (sembrar, sembrar:nube y la prueba de humo). La contraseña la eliges tú.
SEMBRAR_ADMIN_EMAIL=
SEMBRAR_ADMIN_PASSWORD=

